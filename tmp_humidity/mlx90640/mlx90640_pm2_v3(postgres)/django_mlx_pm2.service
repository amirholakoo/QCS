[Unit]
Description=Django Thermal Server
After=network.target

[Service]
User=admin
WorkingDirectory=/home/admin/mlx90640_pm2
Environment="PATH=/home/admin/mlx90640_pm2/env/bin"
ExecStart=/home/admin/mlx90640_pm2/env/bin/python3 manage.py runserver 0.0.0.0:6006
Restart=always

[Install]
WantedBy=multi-user.target


